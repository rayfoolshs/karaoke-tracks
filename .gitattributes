# cmd.exe needs real CRLF bytes in .bat files, and labels/goto break without
# them. -text keeps the bytes exactly as committed (no LF normalisation), so a
# raw download or a zip from GitHub still gives a working file.
*.bat   -text

*.ps1   text eol=crlf
*.txt   text eol=crlf
*.md    text eol=crlf
.gitignore  text eol=lf

# macOS scripts are bash: LF only, and they must stay executable. These
# patterns come last so they win over the generic rules above.
macos/*.command text eol=lf
macos/*.txt     text eol=lf
macos/*.md      text eol=lf
